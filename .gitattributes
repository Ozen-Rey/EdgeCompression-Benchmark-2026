# Normalize text line endings on commit; check out per-OS by default.
* text=auto

# Shell scripts MUST stay LF so they run on Linux/macOS regardless of the
# committer's core.autocrlf setting. CRLF here would break the `#!` shebang.
*.sh text eol=lf

# PowerShell scripts use CRLF (Windows convention; PowerShell also accepts LF).
*.ps1 text eol=crlf

# Binary assets: never apply EOL or charset conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.whl binary
*.pyc binary
